{
  "name": "react-xarrows",
  "version": "2.1.0",
  "author": "Eliav Louski",
  "description": "Draw arrows (or lines) between components in React!",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "unpkg": "./lib/index.umd.js",
  "jsdelivr": "./lib/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      },
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "pnpm run clean && vite build",
    "build:watch": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "pnpm run demo:dev",
    "prepublishOnly": "pnpm run build",
    "demo:dev": "pnpm --filter react-xarrows-examples run dev",
    "demo:build": "pnpm --filter react-xarrows-examples run build",
    "storybook": "pnpm --filter react-xarrows-examples run storybook"
  },
  "homepage": "https://eliav2.github.io/react-xarrows/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eliav2/react-xarrows"
  },
  "bugs": "https://github.com/Eliav2/react-xarrows/issues",
  "funding": {
    "type": "individual",
    "url": "https://www.paypal.com/donate?hosted_button_id=CRQ343F9VTRS8"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@microsoft/api-extractor": "^7.58.12",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.7"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "tabWidth": 2,
    "bracketSameLine": true
  },
  "keywords": [
    "react",
    "reactjs",
    "line",
    "lines",
    "arrow",
    "arrows",
    "xarrows",
    "draw",
    "connect",
    "between",
    "elements",
    "element"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.25.0",
  "sideEffects": false
}
